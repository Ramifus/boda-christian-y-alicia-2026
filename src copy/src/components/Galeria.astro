---
// src/components/Galeria.astro
// "Recuerdos · Nuestras fotos": una frase, un carrusel que pasa las fotos
// solo de izquierda a derecha (también con el dedo), los
// puntitos que marcan cuál se ve. Si hay número de WhatsApp, además el
// pedido de fotos. Flores arriba y abajo.
//
// Cada foto llena el cuadro y entra con un zoom lento: aparece grande y se
// acomoda a su tamaño. Las fotos salen de `galeria` en datos.ts; con la
// lista vacía la galería no se dibuja.
import { galeria, whatsappFotos } from "../datos";

const enlaceWhatsapp = whatsappFotos
    ? `https://wa.me/${whatsappFotos}?text=${encodeURIComponent("¡Hola! Te mando las fotos que saqué en la boda 📸")}`
    : "";
---

{
    galeria.length > 0 && (
        <section id="galeria" class="galeria">
            <img src="/imagenes/florarriba.webp" alt="" aria-hidden="true" width="828" height="276" class="flor flor-arriba" />
            <img src="/imagenes/florabajo.webp" alt="" aria-hidden="true" width="828" height="294" class="flor flor-abajo" />

            <div class="contenido">
                <header class="placa encabezado revelar">
                    <p class="antes">Recuerdos</p>
                    <h2 class="titulo-galeria">Nuestras Fotos</h2>
                </header>

                <p class="frase revelar">Cada foto guarda un pedacito de nuestra historia</p>

                <div class="carrusel revelar" aria-roledescription="carrusel" aria-label="Fotos de los novios">
                    <div class="pista" id="galeria-pista">
                        {galeria.map((f, i) => (
                            <figure class:list={["diapositiva", { activa: i === 0 }]} aria-label={`Foto ${i + 1} de ${galeria.length}`}>
                                <img
                                    src={f.foto}
                                    alt={`Foto ${i + 1} de los novios`}
                                    width={f.ancho}
                                    height={f.alto}
                                    class="foto"
                                    loading={i === 0 ? "eager" : "lazy"}
                                />
                            </figure>
                        ))}
                    </div>

                </div>

                <div class="puntos revelar" id="galeria-puntos">
                    {galeria.map((_, i) => (
                        <button type="button" class:list={["punto", { activo: i === 0 }]} data-foto={i} aria-label={`Ver foto ${i + 1}`} />
                    ))}
                </div>

                {enlaceWhatsapp && (
                    <>
                        <p class="placa pedido revelar">
                            ¿Nos sacaste una foto? Mándanos las tuyas y armamos el álbum entre todos.
                        </p>
                        <a href={enlaceWhatsapp} target="_blank" rel="noopener" class="enviar revelar">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z" />
                            </svg>
                            Enviar fotos
                        </a>
                    </>
                )}
            </div>
        </section>
    )
}

<style>
    .galeria {
        position: relative;
        text-align: center;
        /* Arriba deja ver la flor; el contenido arranca debajo. */
        padding: 3.75rem 1.25rem 0;
        background-image:
            radial-gradient(ellipse at 50% 45%, rgba(241, 236, 221, 0.9) 0%, rgba(251, 248, 240, 0) 70%),
            linear-gradient(#fbf8f0, #fbf8f0);
    }

    .flor {
        position: absolute;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .flor-arriba {
        top: 0;
    }

    .flor-abajo {
        bottom: 0;
        opacity: 0.9;
    }

    .contenido {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* La placa crema translúcida que va detrás de cada bloque. */
    .placa {
        border-radius: 1rem;
        background: rgba(251, 248, 240, 0.8);
        border: 1px solid rgba(195, 213, 182, 0.45);
        box-shadow: 0 1px 3px rgba(47, 69, 54, 0.06);
    }

    .encabezado {
        margin-top: 0.4rem;
        padding: 0.6rem 1.6rem 0.7rem;
    }

    .antes {
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.25rem;
        line-height: 1;
        color: var(--color-segundo);
    }

    .titulo-galeria {
        margin-top: 0.75rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 2.25rem;
        line-height: 1.1;
        color: var(--color-oro-oscuro);
    }

    /* ── El carrusel ──────────────────────────────────────── */
    .carrusel {
        position: relative;
        width: 100%;
        margin-top: 1.25rem;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 12px 28px -14px rgba(47, 69, 54, 0.55);
        border: 1px solid rgba(195, 213, 182, 0.5);
    }

    .pista {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        /* Deslizar sobre las fotos pasa fotos, no páginas. */
        overscroll-behavior-x: contain;
        scrollbar-width: none;
    }

    .pista::-webkit-scrollbar {
        display: none;
    }

    .frase {
        margin-top: 1.1rem;
        max-width: 20rem;
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.25rem;
        line-height: 1.4;
        color: var(--color-segundo);
    }

    .diapositiva {
        position: relative;
        flex: 0 0 100%;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        scroll-snap-align: center;
        background: #f1ecdd;
    }

    /*
       El zoom de entrada: la foto espera agrandada y, cuando le toca,
       se acomoda despacio a su tamaño (con un fundido suave).
    */
    .foto {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        transform: scale(1.22);
        opacity: 0.6;
        transition:
            transform 2.6s cubic-bezier(0.22, 0.61, 0.36, 1),
            opacity 1.2s ease;
    }

    .diapositiva.activa .foto {
        transform: scale(1);
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .foto {
            transform: none;
            transition: opacity 0.6s ease;
        }
    }

    /* ── Los puntitos ─────────────────────────────────────── */
    .puntos {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .punto {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 9999px;
        background: #c3d5b6;
        transition: width 0.3s, background-color 0.3s;
    }

    .punto.activo {
        width: 1.4rem;
        background: var(--color-segundo);
    }

 ───────────────────────────────── */
    /* ── El pedido de fotos ───────────────────────────────── */
    .pedido {
        width: 100%;
        margin-top: 1.6rem;
        padding: 0.9rem 1.25rem;
        font-family: var(--font-texto);
        font-size: 0.9rem;
        line-height: 1.55;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--color-primero) 75%, transparent);
    }

    .enviar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 3rem;
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        background: var(--color-segundo);
        color: #fbf8f0;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        box-shadow: 0 8px 18px -8px rgba(87, 118, 79, 0.7);
    }

    .enviar svg {
        width: 1rem;
    }
</style>

<script>
    const pista = document.getElementById("galeria-pista");
    const puntos = Array.from(document.querySelectorAll<HTMLElement>("#galeria-puntos .punto"));
    const diapositivas = Array.from(document.querySelectorAll<HTMLElement>("#galeria-pista .diapositiva"));

    if (pista && puntos.length > 0) {
        const total = puntos.length;
        let actual = 0;

        // Marca la foto que se ve: dispara su zoom y mueve el puntito.
        function marcar(i: number) {
            diapositivas.forEach((d, j) => d.classList.toggle("activa", j === i));
            puntos.forEach((p, j) => p.classList.toggle("activo", j === i));
        }

        const ir = (i: number) => {
            // Al pasar la última vuelve a la primera, y al revés.
            actual = (i + total) % total;
            pista.scrollTo({ left: actual * pista.clientWidth });
        };

        pista.addEventListener(
            "scroll",
            () => {
                const i = Math.round(pista.scrollLeft / pista.clientWidth);
                if (i === actual && diapositivas[i]?.classList.contains("activa")) return;
                actual = i;
                marcar(i);
            },
            { passive: true },
        );

        /*
           Pasa sola cada 4,5 segundos mientras la página de la galería está
           a la vista. Si el invitado toca el carrusel se queda quieta un
           rato (para no quitarle la foto que mira) y después sigue sola.
        */
        let reloj: number | undefined;
        let espera: number | undefined;
        let visible = false;

        function arrancar() {
            clearInterval(reloj);
            if (visible) reloj = window.setInterval(() => ir(actual + 1), 4500);
        }

        function pausar() {
            clearInterval(reloj);
            clearTimeout(espera);
            espera = window.setTimeout(arrancar, 7000);
        }

        pista.addEventListener("pointerdown", pausar, { passive: true });

        puntos.forEach((p) =>
            p.addEventListener("click", () => {
                pausar();
                ir(Number(p.dataset.foto));
            }),
        );

        new IntersectionObserver(
            ([e]) => {
                visible = e.isIntersecting;
                if (visible) {
                    // Cada vez que se llega a la galería, la foto vuelve a
                    // entrar con su zoom.
                    diapositivas[actual]?.classList.remove("activa");
                    requestAnimationFrame(() => requestAnimationFrame(() => marcar(actual)));
                    arrancar();
                } else {
                    clearInterval(reloj);
                    clearTimeout(espera);
                }
            },
            { threshold: 0.6 },
        ).observe(pista);
    }
</script>
