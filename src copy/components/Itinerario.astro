---
// src/components/Itinerario.astro
// Los momentos del día, sobre una línea vertical con un ícono por momento.
// Los que todavía no tienen hora en datos.ts salen sin el número.
import Separador from "./Separador.astro";
import { itinerario } from "../datos";
---

<section id="itinerario" class="seccion itinerario">
    <p class="antetitulo revelar">Así será nuestro día</p>
    <h2 class="titulo mt-3 revelar">Itinerario</h2>
    <Separador class="mt-4 revelar" />

    <ol class="linea">
        {
            itinerario.map((m) => (
                <li class="momento revelar">
                    <span class="circulo">
                        <span class="icono" style={`--ic:url('${m.icono}')`} />
                    </span>
                    <div class="detalle">
                        {m.hora && <span class="hora">{m.hora}</span>}
                        <h3 class="titulo-tarjeta nombre">{m.momento}</h3>
                    </div>
                </li>
            ))
        }
    </ol>
</section>

<style>
    .itinerario {
        background-image: linear-gradient(#f1ecdd, #f1ecdd);
    }

    .linea {
        position: relative;
        margin: 2.6rem auto 0;
        max-width: 19rem;
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        text-align: left;
    }

    /* La línea que une los círculos. */
    .linea::before {
        content: "";
        position: absolute;
        top: 1.6rem;
        bottom: 1.6rem;
        left: 1.95rem;
        width: 1px;
        background: linear-gradient(#bfa06a, #c3d5b6);
    }

    .momento {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .circulo {
        flex: none;
        width: 3.9rem;
        height: 3.9rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #fbf8f0;
        border: 1px solid #bfa06a;
        box-shadow: 0 6px 16px -10px rgba(47, 69, 54, 0.5);
        color: var(--color-segundo);
    }

    .circulo .icono {
        width: 2rem;
        height: 2rem;
    }

    .hora {
        font-family: var(--font-nombre);
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        color: var(--color-oro-oscuro);
    }

    .nombre {
        font-size: 2.1rem;
    }
</style>
