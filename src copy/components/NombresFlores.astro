---
// src/components/NombresFlores.astro
// Lo primero que se ve al abrir el sobre: flores arriba y abajo,
// "¡Nos casamos!", los nombres, y la tarjeta con día, fecha y hora.
import { novios, fechaPortada } from "../datos";
---

<section id="inicio" class="portada">
    <!-- Las iniciales en marca de agua, apenas visibles detrás. -->
    <p class="marca-agua" aria-hidden="true">
        <span>{novios.iniciales[0]}</span><span class="segunda">{novios.iniciales[1]}</span>
    </p>

    <img src="/imagenes/florarriba.webp" alt="" aria-hidden="true" width="828" height="276" class="flor flor-arriba" />

    <div class="contenido">
        <p class="nos-casamos entrada-portada">¡Nos casamos!</p>

        <h1 class="nombres">
            <span class="entrada-portada">{novios.el}</span>
            <span class="y entrada-portada">&</span>
            <span class="entrada-portada">{novios.ella}</span>
        </h1>

        <div class="divisor entrada-portada" aria-hidden="true">
            <span class="linea linea-izq"></span>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M8 2.5 L11 8 L8 13.5 L5 8 Z"></path>
                <circle cx="8" cy="8" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
            <span class="linea linea-der"></span>
        </div>

        <div class="tarjeta-fecha entrada-portada">
            <p class="columna lado">{fechaPortada.dia}</p>
            <div class="columna centro">
                <p class="numero">{fechaPortada.numeros}</p>
                <p class="mes">{fechaPortada.mes}<br />{fechaPortada.anio}</p>
            </div>
            <p class="columna lado">{fechaPortada.hora}<br />{fechaPortada.periodo}</p>
        </div>

        <a href="#cuenta-regresiva" class="desliza entrada-portada">
            Desliza para leer
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </a>
    </div>

    <img src="/imagenes/florabajo.webp" alt="" aria-hidden="true" width="828" height="294" class="flor flor-abajo" />
</section>

<style>
    .portada {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        text-align: center;
        padding: 9rem 1.25rem 10rem;
        /* Papel crema con una aguada suave al centro (como imagen, por el modo oscuro). */
        background-image:
            radial-gradient(ellipse at 50% 45%, rgba(241, 236, 221, 0.9) 0%, rgba(251, 248, 240, 0) 70%),
            linear-gradient(#fbf8f0, #fbf8f0);
    }

    .marca-agua {
        position: absolute;
        top: 3.2rem;
        left: 50%;
        transform: translateX(-50%);
        font-family: var(--font-iniciales);
        font-size: 6.5rem;
        line-height: 1;
        color: var(--color-oro);
        opacity: 0.07;
        pointer-events: none;
        white-space: nowrap;
    }

    .marca-agua .segunda {
        display: inline-block;
        margin-left: -0.3em;
        transform: translateY(0.25em);
    }

    .flor {
        position: absolute;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .flor-arriba {
        top: 0;
        transform-origin: top center;
        animation: mecer-flor 8s ease-in-out infinite;
    }

    .flor-abajo {
        bottom: 0;
        transform-origin: bottom center;
        animation: mecer-flor 8s ease-in-out infinite -4s;
    }

    @keyframes mecer-flor {
        0%, 100% { transform: rotate(0); }
        50% { transform: rotate(0.8deg); }
    }

    .contenido {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .nos-casamos {
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.875rem;
        line-height: 1;
        color: var(--color-segundo);
    }

    .nombres {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 1.1rem;
        font-family: var(--font-nombre);
        font-style: italic;
        font-weight: 400;
        font-size: 3rem;
        line-height: 1.15;
        color: var(--color-primero);
    }

    .nombres .y {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--color-oro);
    }

    .divisor {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        max-width: 20rem;
        margin-top: 1.6rem;
        color: var(--color-segundo);
    }

    .divisor svg {
        width: 1rem;
        flex: none;
    }

    .linea {
        flex: 1;
        height: 1px;
    }

    .linea-izq {
        background: linear-gradient(to right, transparent, #c3d5b6);
    }

    .linea-der {
        background: linear-gradient(to left, transparent, #c3d5b6);
    }

    /* ── La tarjeta de la fecha ───────────────────────────── */
    .tarjeta-fecha {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        width: 100%;
        margin-top: 1.4rem;
        padding: 1.4rem 0.5rem;
        border-radius: 1.5rem;
        background: rgba(251, 248, 240, 0.8);
        border: 1px solid rgba(195, 213, 182, 0.5);
        box-shadow: 0 1px 3px rgba(47, 69, 54, 0.08);
    }

    .columna {
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.875rem;
        line-height: 1.45;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--color-primero) 75%, transparent);
    }

    .centro {
        padding: 0 1rem;
        border-left: 1px solid #c3d5b6;
        border-right: 1px solid #c3d5b6;
    }

    /* Los dos días, en Bodoni (recta), como el monograma del sobre. */
    .numero {
        font-family: var(--font-iniciales);
        font-weight: 400;
        font-size: 2.1rem;
        line-height: 1.1;
        letter-spacing: 0.02em;
        white-space: nowrap;
        color: var(--color-primero);
    }

    .mes {
        margin-top: 0.5rem;
    }

    /* ── El botón de seguir ───────────────────────────────── */
    .desliza {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 2.2rem;
        padding: 0.7rem 1.4rem;
        border-radius: 9999px;
        background: rgba(251, 248, 240, 0.8);
        border: 1px solid rgba(195, 213, 182, 0.6);
        box-shadow: 0 1px 3px rgba(47, 69, 54, 0.08);
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-segundo);
    }

    .desliza svg {
        width: 1rem;
        animation: empujar 1.6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .flor-arriba, .flor-abajo, .desliza svg { animation: none; }
    }
</style>

<script>
    import { gsap } from "gsap";

    const piezas = document.querySelectorAll(".entrada-portada");
    gsap.set(piezas, { opacity: 0, y: 16 });

    // Entra recién cuando se abre el sobre, para que no pase escondida.
    window.addEventListener(
        "invitacion-abierta",
        () => {
            gsap.to(piezas, {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.12,
                ease: "sine.out",
                delay: 0.2,
            });
        },
        { once: true },
    );
</script>
