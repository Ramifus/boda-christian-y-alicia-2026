---
// src/components/SugerenciaRegalo.astro
// Franja de papel crema rasgada con el "Sugerencias" y, debajo: el aviso,
// el logo de Hiper Hogar, el botón a la lista de regalos, el tulipán y el
// QR del banco.
//
// El ramo de arriba va POR ENCIMA del papel, como en el código de
// vestimenta.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda   25% de alto
//   logo y botón, del mismo ancho, uno debajo del otro
//   flor2 13% de ancho · QR 31%

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Sugerencias";

const aviso = [
    "Su presencia es lo más importante,",
    "pero si desean hacernos un presente:",
];

const textoBoton = "Lista de regalos";
// El PDF con la lista, que vive en public/imagenes. Se abre en otra
// pestaña, así el invitado no pierde la invitación.
const listaRegalos = "/imagenes/lista-regalos.pdf";

// Los datos de la cuenta, debajo del QR
const cuenta = ["Cuenta destino: 1503273485", "Pagar a: Vargas Fernández Sebastián"];
// ──────────────────────────────────────────────────────────────
---

<section id="sugerencia-regalo" class="seccion">
    <div class="marco-banda">
        <!--
           El ramo asoma por detrás del papel. Va adentro de una caja: la
           caja es la que se anima y la imagen se queda con su volteo, sin
           que uno pise al otro.
        -->
        <span class="caja-flores" aria-hidden="true">
            <img
                src="/imagenes/florlateral2.png"
                alt=""
                width="756"
                height="960"
                class="flores"
            />
        </span>

        <div id="banda-regalos" class="banda">
            <h2 class="titulo font-elegant">{titulo}</h2>
        </div>
    </div>

    <div id="cuerpo-regalos" class="cuerpo">
        <p class="aviso font-cormorant">
            {aviso[0]}<br />{aviso[1]}
        </p>

        <!-- El logo va en su propia tarjeta blanca, como en el diseño -->
        <div class="tarjeta-logo">
            <img
                src="/imagenes/hiperhogar.png"
                alt="Hiper Hogar"
                width="614"
                height="244"
                class="logo"
            />
        </div>

        <!--
           El botón lleva un ícono de lista al lado del texto: sin él, un
           rectángulo de color solo no se lee como algo para tocar.
        -->
        <a
            class="boton font-cormorant"
            href={listaRegalos}
            target="_blank"
            rel="noopener noreferrer"
        >
            <svg
                class="icono-lista"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"
                ></path>
                <path d="M14 3v5h5"></path>
                <path d="M9 13h6"></path>
                <path d="M9 17h4"></path>
            </svg>
            <span>{textoBoton}</span>
        </a>

        <p class="pista font-cormorant">Toca el botón para ver la lista de regalos</p>

        <img
            src="/imagenes/flor2.png"
            alt=""
            aria-hidden="true"
            width="233"
            height="132"
            class="flor"
        />

        <!-- El QR ya trae el rótulo BNB adentro de la imagen -->
        <img
            src="/imagenes/qr.png"
            alt="Código QR de la cuenta del BNB"
            width="441"
            height="505"
            class="qr"
        />

        <div class="cuenta font-cormorant">
            {cuenta.map((linea) => <p>{linea}</p>)}
        </div>
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 3.5rem;
    }

    /* Sin recorte propio: el ramo tiene que poder salirse de la banda */
    .marco-banda {
        position: relative;
        width: 100%;
    }

    /*
       z-index 0: DETRÁS del papel (la banda va con 1), así el ramo asoma
       por el filo rasgado. Espejado en horizontal para que se abra hacia
       el borde derecho, que es del lado que entra.
    */
    /*
       La caja lleva la posición y es la que anima GSAP; la imagen guarda
       el volteo. Separadas a propósito: si la animación tocara la misma
       imagen que lleva el scaleX(-1), GSAP leería ese menos como media
       vuelta y el ramo giraría como un trompo al entrar.
    */
    .caja-flores {
        position: absolute;
        top: -6.5rem;
        right: -1rem;
        width: 24%;
        z-index: 0;
        pointer-events: none;
        filter: drop-shadow(0 6px 10px rgba(90, 70, 20, 0.18));
    }

    .flores {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        transform: scaleX(-1);
    }

    /*
       La banda de papel: el mismo rasgado del modelo, con el trazo corrido
       (35 arriba y 3 abajo) para que no repita el de las otras franjas.
    */
    .banda {
        position: relative;
        width: 100%;
        z-index: 1;
        background: #f7f3d3;
        padding: 2.6rem 1.8rem 2.8rem;
        clip-path: polygon(
            0.00% 2.09%,
            1.82% 0.51%,
            3.64% 1.63%,
