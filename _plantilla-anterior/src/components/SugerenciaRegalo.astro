            20.00% 92.95%,
            18.18% 95.67%,
            16.36% 93.64%,
            14.55% 93.51%,
            12.73% 93.54%,
            10.91% 94.00%,
            9.09% 95.11%,
            7.27% 94.44%,
            5.45% 93.84%,
            3.64% 94.02%,
            1.82% 93.49%,
            0.00% 95.75%
        );
    }

    /* Mismo tamaño y color que los otros títulos de la invitación */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(2.35rem, 10.7vw, 2.9rem);
        line-height: 1.2;
    }

    /* ── El cuerpo ─────────────────────────────────────────── */
    .cuerpo {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.4rem 1rem 0;
        text-align: center;
    }

    /*
       Este renglón va en Cormorant y no en la caligrafía: es el que
       explica algo concreto y tiene que leerse de un vistazo.
    */
    .aviso {
        color: #643e1a;
        font-size: clamp(1.25rem, 5.5vw, 1.45rem);
        line-height: 1.55;
    }

    /*
       El logo y el botón comparten ancho: en el diseño están alineados uno
       encima del otro y así se leen como un solo bloque.
    */
    /*
       Solo la tarjeta del logo lleva ancho fijo. El botón se mide por su
       texto: si le imponía este ancho, "LISTA DE REGALOS" se le salía.
    */
    .tarjeta-logo {
        width: 46%;
        max-width: 12.5rem;
        box-sizing: border-box;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(90, 65, 25, 0.12);
    }

    .tarjeta-logo {
        margin-top: 1.6rem;
        padding: 0.7rem 1.2rem;
        background: #ffffff;
    }

    .logo {
        display: block;
        width: 100%;
        height: auto;
    }

    /*
       Mismo trato que el botón de la recepción —mayúsculas, letras
       separadas, Cormorant— pero pintado en el naranja de Hiper Hogar.
    */
    .boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.1rem;
        padding: 0.6rem 1.5rem;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        /* Sin separación entre letras y en un solo renglón */
        white-space: nowrap;
        color: #ffffff;
        background: #ff7100;
        border-radius: 999px;
        font-size: clamp(1.05rem, 4.6vw, 1.2rem);
        line-height: 1.4;
        box-shadow: 0 5px 14px rgba(255, 113, 0, 0.35);
        /* Late despacio para que se note que se puede tocar */
        animation: latido 2.6s ease-in-out infinite;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background-color 0.25s ease;
    }

    @keyframes latido {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.045);
        }
    }

    .icono-lista {
        width: 1.05em;
        height: 1.05em;
        flex-shrink: 0;
    }

    .boton:hover {
        background: #ff8420;
        box-shadow: 0 9px 20px rgba(255, 113, 0, 0.45);
    }

    /* Se hunde al tocarlo: la señal de que respondió */
    .boton:active {
        animation: none;
        transform: scale(0.97);
        box-shadow: 0 2px 6px rgba(90, 65, 25, 0.2);
    }

    /* La pista de abajo: le dice al invitado qué pasa si lo toca */
    .pista {
        margin-top: 0.5rem;
        color: #643e1a;
        font-size: clamp(1.2rem, 5.2vw, 1.35rem);
        line-height: 1.4;
    }

    /* Quien pide menos movimiento no ve el latido */
    @media (prefers-reduced-motion: reduce) {
        .boton {
            animation: none;
        }
    }

    .flor {
        display: block;
        width: 22%;
        max-width: 6rem;
        height: auto;
        margin-top: 1.6rem;
        user-select: none;
    }

    /* Bien grande: tiene que poder escanearse desde el teléfono */
    .qr {
        display: block;
        width: 52%;
        max-width: 14rem;
        height: auto;
        margin-top: 1.2rem;
    }

    /*
       Los datos de la cuenta también en Cormorant: son un número
       que alguien va a copiar, y la caligrafía se presta a confusiones.
    */
    .cuenta {
        margin-top: 1rem;
        color: #643e1a;
        font-size: clamp(1.1rem, 4.8vw, 1.25rem);
        line-height: 1.6;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-regalos");
        const cuerpo = document.getElementById("cuerpo-regalos");
        if (!banda || !cuerpo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           Las flores entran creciendo desde chiquitas hasta su tamaño y
           después quedan meciéndose despacio, como si estuvieran vivas.
           El volteo viaja dentro de la animación (el signo de scaleX /
           scaleY) y no en el CSS: GSAP escribe su propio transform, así
           que si lo dejaba en la hoja de estilos se perdería al animar.
        */
        const flores = document.querySelector<HTMLElement>(
            "#sugerencia-regalo .caja-flores",
        );
        if (flores) {
            gsap.fromTo(
                flores,
                { scale: 0.45, x: 70, opacity: 0 },
                {
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    duration: 1.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: flores,
                        start: "top 95%",
                        toggleActions: "play none none reset",
                    },
                    onComplete: () => {
                        gsap.to(flores, {
                            rotation: 1.6,
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );
        }

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        gsap.fromTo(
            cuerpo.children,
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.12,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: cuerpo,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
