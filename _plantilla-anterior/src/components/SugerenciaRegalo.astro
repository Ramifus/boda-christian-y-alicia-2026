            60.00% 6.36%,
            61.82% 4.33%,
            63.64% 7.05%,
            65.45% 5.69%,
            67.27% 3.71%,
            69.09% 2.14%,
            70.91% 1.75%,
            72.73% 2.50%,
            74.55% 3.40%,
            76.36% 5.33%,
            78.18% 4.30%,
            80.00% 5.93%,
            81.82% 6.47%,
            83.64% 6.21%,
            85.45% 4.14%,
            87.27% 5.07%,
            89.09% 5.17%,
            90.91% 6.42%,
            92.73% 5.33%,
            94.55% 5.17%,
            96.36% 4.87%,
            98.18% 3.99%,
            100.00% 2.21%,
            100.00% 96.00%,
            98.18% 95.85%,
            96.36% 91.50%,
            94.55% 94.36%,
            92.73% 95.05%,
            90.91% 94.00%,
            89.09% 96.16%,
            87.27% 94.21%,
