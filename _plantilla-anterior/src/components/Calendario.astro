            50.91% 4.33%,
            52.73% 7.05%,
            54.55% 5.69%,
            56.36% 3.71%,
            58.18% 2.14%,
            60.00% 1.75%,
            61.82% 2.50%,
            63.64% 3.40%,
            65.45% 5.33%,
            67.27% 4.30%,
            69.09% 5.93%,
            70.91% 6.47%,
            72.73% 6.21%,
            74.55% 4.14%,
            76.36% 5.07%,
            78.18% 5.17%,
            80.00% 6.42%,
            81.82% 5.33%,
            83.64% 5.17%,
            85.45% 4.87%,
            87.27% 3.99%,
            89.09% 2.21%,
            90.91% 2.09%,
            92.73% 0.51%,
            94.55% 1.63%,
            96.36% 2.75%,
            98.18% 2.97%,
            100.00% 4.20%,
            100.00% 95.11%,
            98.18% 94.44%,
            96.36% 93.84%,
            94.55% 94.02%,
            92.73% 93.49%,
            90.91% 95.75%,
            89.09% 96.00%,
