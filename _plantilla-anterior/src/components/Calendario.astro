---
// src/components/Calendario.astro
// Franja de papel crema rasgada con el "Calendario" y las flores asomando
// por la esquina de arriba a la derecha; debajo, la tarjeta con el mes:
// el nombre y el año a la izquierda, el tulipán al medio y la grilla del
// mes a la derecha, con el día de la boda marcado con un corazón.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda    21% de alto
//   tarjeta  60.5% de ancho, centrada
// Y adentro de la tarjeta, en % de SU ancho:
//   mes 7.5% · año 14% · grilla 3.6% · tulipán 11% de ancho

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Calendario";
// La boda: 19 de septiembre de 2026 (mes 8 porque enero es 0)
const anioBoda = 2026;
const mesBoda = 8;
const diaBoda = 19;
const nombreMes = "Septiembre";
// ──────────────────────────────────────────────────────────────

const cabeceras = ["D", "L", "M", "M", "J", "V", "S"];

/*
   La grilla se arma sola con la fecha: así el mes siempre cae en el día
   de la semana correcto y no hay que dibujarlo a mano.
   Septiembre de 2026 arranca un martes y tiene 30 días.
*/
const primerDia = new Date(anioBoda, mesBoda, 1).getDay();
const diasDelMes = new Date(anioBoda, mesBoda + 1, 0).getDate();

const celdas: (number | null)[] = [
    ...Array(primerDia).fill(null),
    ...Array.from({ length: diasDelMes }, (_, i) => i + 1),
];
while (celdas.length % 7 !== 0) celdas.push(null);

const semanas: (number | null)[][] = [];
for (let i = 0; i < celdas.length; i += 7) semanas.push(celdas.slice(i, i + 7));
---

<section id="calendario" class="seccion">
    <div class="marco-banda">
        <!--
           Las flores pisan la banda desde la esquina de arriba a la
           derecha. Van adentro de una caja: la caja es la que se anima y
           la imagen se queda con su volteo, sin que uno pise al otro.
        -->
        <span class="caja-flores" aria-hidden="true">
            <img
                src="/imagenes/florlateral.png"
                alt=""
                width="440"
                height="482"
                class="flores"
            />
        </span>

        <div id="banda-calendario" class="banda">
            <h2 class="titulo font-elegant">{titulo}</h2>
        </div>
    </div>

    <div id="tarjeta-calendario" class="tarjeta">
        <!-- Mes y año -->
        <div class="mes">
            <p class="nombre-mes font-rantera">{nombreMes}</p>

            <div class="fila-anio">
                <svg class="corazon" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                        d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z"
                    ></path>
                </svg>
                <p class="anio font-elegant">{anioBoda}</p>
            </div>
        </div>

        <!-- El tulipán, parado entre el mes y la grilla -->
        <img
            src="/imagenes/flo.png"
            alt=""
            aria-hidden="true"
            width="74"
            height="365"
            class="tulipan"
        />

        <!-- La grilla del mes -->
        <div class="grilla">
            {cabeceras.map((c) => <span class="cabecera">{c}</span>)}

            {
                semanas.map((semana) =>
                    semana.map((dia) => (
                        <span class:list={["dia", { boda: dia === diaBoda }]}>
                            {dia && (
                                <>
                                    {dia === diaBoda && (
                                        <svg
                                            class="marca"
                                            viewBox="0 0 24 24"
                                            aria-hidden="true"
                                        >
                                            <path d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z" />
                                        </svg>
                                    )}
                                    <span class="numero">{dia}</span>
                                </>
                            )}
                        </span>
                    )),
                )
            }
        </div>
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 3.5rem;
    }

    /* Sin recorte: las flores tienen que poder salirse de la banda */
    .marco-banda {
        position: relative;
        width: 100%;
    }

    /*
       Espejadas en horizontal para que entren desde la derecha: la imagen
       viene con los tallos hacia la izquierda.
    */
    /*
       La caja lleva la posición y es la que anima GSAP. La imagen de
       adentro guarda el volteo. Están separadas a propósito: si la
       animación tocara la misma imagen que lleva el scaleX(-1), GSAP
       leería ese menos como media vuelta y el ramo giraría como un trompo
       al entrar.
    */
    .caja-flores {
        position: absolute;
        top: -2.5rem;
        right: -1.5rem;
        width: 30%;
        z-index: 2;
        pointer-events: none;
        filter: drop-shadow(0 6px 10px rgba(90, 70, 20, 0.18));
    }

    .flores {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        /* Espejada en horizontal para entrar por la derecha, y volteada
           en vertical para que los tulipanes miren hacia arriba */
        transform: scaleX(-1) scaleY(-1);
    }

    /*
       La banda de papel: el mismo rasgado del modelo, con el trazo corrido
       otra vez para que no sea calcado al de las otras franjas.
    */
    .banda {
        position: relative;
        width: 100%;
        background: #f7f3d3;
        padding: 2.6rem 1.8rem 2.8rem;
        clip-path: polygon(
            0.00% 6.82%,
            1.82% 5.66%,
            3.64% 5.36%,
            5.45% 3.60%,
