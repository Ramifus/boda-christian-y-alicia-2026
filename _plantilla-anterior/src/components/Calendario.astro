            1.82% 93.54%,
            0.00% 94.00%
        );
    }

    /* Mismo tamaño y color que el título de la Fecha y del Contador */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(2.35rem, 10.7vw, 2.9rem);
        line-height: 1.2;
    }

    /* ── La tarjeta del mes ────────────────────────────────── */
    .tarjeta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3%;
        width: 88%;
        max-width: 24rem;
        margin: 2.8rem auto 0;
        padding: 5% 4%;
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0 12px 28px rgba(90, 65, 25, 0.13);
        /* Todo lo de adentro se mide contra el ancho de la tarjeta */
        container-type: inline-size;
    }

    .mes {
        flex: 1 1 auto;
        min-width: 0;
        text-align: center;
    }

    .nombre-mes {
        color: #6b4e14;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 7.4cqw;
        line-height: 1.1;
        white-space: nowrap;
    }

    .fila-anio {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2%;
        margin-top: 2%;
    }

    .corazon {
        width: 7cqw;
        height: 7cqw;
        flex-shrink: 0;
        fill: #f3ebb2;
    }

    .anio {
        color: #6b4e14;
        font-size: 14.2cqw;
        line-height: 1;
    }

    /* El tulipán marca la mitad de la tarjeta */
    /*
       Se mide por el ALTO y no por el ancho: la imagen es muy angosta
       (74x365) y dándole el ancho quedaba un hilo de pocos píxeles. Con
       42cqw de alto mide lo mismo que en el diseño y el ancho sale solo.
    */
    .tulipan {
        flex: 0 0 auto;
        height: 42cqw;
        width: auto;
        align-self: center;
        pointer-events: none;
        user-select: none;
    }

    /* ── La grilla del mes ─────────────────────────────────── */
    .grilla {
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.35cqw;
        width: 42cqw;
        text-align: center;
    }

    .cabecera {
        color: #98835e;
        font-family: "Cormorant Garamond", serif;
        font-size: 4.8cqw;
        line-height: 2;
    }

    /*
       Cada celda es cuadrada: así el corazón del día de la boda queda
       centrado sobre el número sin desacomodar la fila.
    */
    .dia {
        position: relative;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b4e14;
        font-family: "Cormorant Garamond", serif;
        font-size: 5.2cqw;
        line-height: 1;
    }

    .numero {
        position: relative;
        z-index: 1;
    }

    /* El corazón del día de la boda: solo el contorno, detrás del número */
    .marca {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 7.2cqw;
        height: 7.2cqw;
        transform: translate(-50%, -50%);
        fill: none;
        stroke: #e8dc93;
        stroke-width: 1.6;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-calendario");
        const tarjeta = document.getElementById("tarjeta-calendario");
        if (!banda || !tarjeta) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           Las flores entran creciendo desde chiquitas hasta su tamaño y
           después quedan meciéndose despacio, como si estuvieran vivas.

           Se anima la CAJA y no la imagen: la imagen lleva el volteo
           (scaleX/scaleY en -1) y GSAP lee ese menos como media vuelta, así
           que si la animara a ella el ramo giraría como un trompo.
        */
        const flores = document.querySelector<HTMLElement>(
            "#calendario .caja-flores",
        );
        if (flores) {
            gsap.fromTo(
                flores,
                { scale: 0.45, x: 70, opacity: 0 },
                {
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    duration: 1.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: flores,
                        start: "top 95%",
                        toggleActions: "play none none reset",
                    },
                    onComplete: () => {
                        gsap.to(flores, {
                            rotation: 1.6,
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );
        }

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        gsap.fromTo(
            tarjeta,
            { opacity: 0, y: 22 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: tarjeta,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // El corazón del día de la boda late apenas, para que se note
        const marca = tarjeta.querySelector(".marca");
        if (marca) {
            gsap.fromTo(
                marca,
                { scale: 0.7, opacity: 0 },
                {
                    scale: 1,
                    opacity: 1,
                    duration: 0.8,
                    delay: 0.6,
                    ease: "back.out(2)",
                    transformOrigin: "center",
                    scrollTrigger: {
                        trigger: tarjeta,
                        start: "top 88%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }
    });
</script>
