---
// src/components/Despedida.astro
// Cierre de la invitación: entre dos filigranas doradas, el saludo a la
// familia, los tres párrafos de despedida y el botón que confirma la
// asistencia por WhatsApp.
//
// ── De dónde salen las medidas ────────────────────────────────
// Se midió el diseño y se cruzó con los anchos reales de las fuentes:
//
//   título     Verandah Reverie — la letra de los títulos de toda la
//              invitación, al mismo tamaño que en las otras secciones
//   párrafos   Tangerine Regular — los siete renglones dan 6.46cqw con
//              menos de 2% de diferencia entre sí, así que es esa
//
// Las filigranas van derechas, sin voltear: comparadas con el archivo,
// en este diseño miran para el mismo lado que el original.
//
// El botón es el mismo de CeremoniaReligiosa y RecepcionSocial: verde
// liso, filete dorado y un ícono adelante. Si se toca uno, conviene
// mirar los otros dos.
//
// Todo se mide contra el ancho de la columna: 1cqw = 1% de ese ancho.

// ── DATOS EDITABLES ───────────────────────────────────────────
// Tanto la Verandah del título como la Tangerine de los párrafos traen
// los acentuados del castellano, así que acá se escribe normal.
const titulo = "Querida Familia y Amigos";

/*
   Cada párrafo trae sus renglones ya partidos, como en el diseño. No se
   dejan partir solos a propósito: el corte de estas frases está pensado
   y con partición automática se acomodan donde caiga.
*/
const parrafos = [
    ["Nos llena de felicidad poder", "compartir con ustedes este momento tan especial."],
    ["Con la esperanza de que hagamos de este día un", "recuerdo inolvidable."],
    [
        "Los esperamos con los corazones llenos de emoción,",
        "listos para celebrar con amor y crear memorias",
        "que permanezcan por siempre.",
    ],
];

const textoBoton = "Confirma tu asistencia";

/*
   El botón abre WhatsApp con el mensaje ya escrito.

   El número va con el código de país y sin el + ni espacios, que es como
   lo pide wa.me: el +591 61006490 de los novios se escribe 59161006490.

   Los nombres y la fecha no se repiten dentro del mensaje: salen de
   estas dos constantes, así que si alguna cambia, el mensaje se
   actualiza solo y no queda una fecha vieja escondida en el texto.

   El mensaje va en texto pelado, sin emojis: el invitado lo manda tal
   cual le aparece, y un emoji en el medio lo vuelve informal.
*/
const telefono = "59161006490";
const novios = "Ayato y Fabiola";
const fechaBoda = "24 de octubre de 2026";
const mensaje = `Me complace confirmar mi asistencia a la boda de ${novios}, que será realizada el ${fechaBoda}. Estaré sin falta.`;
const enlaceConfirmar = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
// ──────────────────────────────────────────────────────────────
---

<section id="despedida" class="seccion">
    <img
        src="/imagenes/separador-arriba.webp"
        alt=""
        width="760"
        height="166"
        aria-hidden="true"
        class="filigrana filigrana-arriba"
    />

    <p class="titulo font-verandah">{titulo}</p>

    <div id="texto-despedida" class="texto">
        {
            parrafos.map((parrafo) => (
                <p class="parrafo font-tangerine">
                    {parrafo.map((linea) => (
                        <span class="renglon">{linea}</span>
                    ))}
                </p>
            ))
        }
    </div>

    <img
        src="/imagenes/separador-abajo.webp"
        alt=""
        width="760"
        height="163"
        aria-hidden="true"
        class="filigrana filigrana-abajo"
    />

    <!--
       El botón es un enlace de verdad, no un texto con un click pegado:
       así se puede abrir en otra pestaña y el lector de pantalla lo
       anuncia como lo que es.
    -->
    <a
        id="boton-confirmar"
        class="boton font-tangerine"
        href={enlaceConfirmar}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Confirmar la asistencia por WhatsApp"
    >
        <!-- El tilde de confirmado: es lo que hace que se lea como botón
             de un vistazo, sin tener que probarlo -->
        <svg
            class="tilde"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
        >
            <path
                d="M20.3 5.7a1 1 0 0 1 0 1.4L9.9 17.5a1 1 0 0 1-1.4 0l-4.8-4.8a1 1 0 1 1 1.4-1.4l4.1 4.1 9.7-9.7a1 1 0 0 1 1.4 0z"
            ></path>
        </svg>
        {textoBoton}
    </a>
</section>

<style>
    /*
       container-type deja medir todo contra el ancho de la columna y no
       contra la pantalla: 1cqw es el 1% de ese ancho.
    */
    .seccion {
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 8% 0 10%;
        text-align: center;
    }

    .filigrana {
        display: block;
        height: auto;
        margin: 0 auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Las dos filigranas no son gemelas: cada una trae su propio ancho */
    .filigrana-arriba {
        width: 45.7%;
    }

    .filigrana-abajo {
        width: 44.9%;
        margin-top: 7cqw;
    }

    .titulo {
        margin: 7.8cqw 0 0;
        color: #085843;
        font-size: 9.4cqw;
        line-height: 1;
    }

    .texto {
        margin-top: 9.5cqw;
    }

    /* El diseño daba 6.46cqw y 1.08 de interlineado; se agrandó la letra
       y se abrieron los renglones a pedido */
    .parrafo {
        margin: 0;
        color: #4f7a74;
        font-size: 7cqw;
        line-height: 1.45;
    }

    /* Cada renglón, uno debajo del otro: el corte lo manda el dato, no
       el ancho de la pantalla */
    .renglon {
        display: block;
    }

    /* El aire entre un párrafo y el siguiente, no entre sus renglones */
    .parrafo + .parrafo {
        margin-top: 8cqw;
    }

    /* ── El botón de confirmar ──────────────────────────────── */
    /*
       Botón liso: un solo color, sin degradados y sin imagen de fondo,
       igual que el de las dos ubicaciones.

       El verde va escrito como degradado de un solo color y no como
       background-color a propósito: el modo oscuro forzado de algunos
       celulares recalcula los colores pero respeta las imágenes, y un
       degradado cuenta como imagen. Así el botón se ve igual en todos.
    */
    .boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.3em;
        margin-top: 14.8cqw;
        padding: 2.8cqw 7cqw;
        border-radius: 999px;
        /* Un filete dorado finito: es lo único que lleva de adorno */
        border: 1px solid rgba(201, 164, 95, 0.6);
        background-image: linear-gradient(#075843, #075843);
        color: #f6efe1;
        font-size: 6.2cqw;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        /* El dedo lo aprieta entero, también en los bordes */
        touch-action: manipulation;
        box-shadow: 0 3px 9px rgba(7, 88, 67, 0.3);
        transition: box-shadow 0.18s ease;
    }

    .tilde {
        width: 0.66em;
        height: 0.66em;
        fill: #f6efe1;
        /* La cursiva se apoya más abajo que el ícono: este empujón los
           deja a la misma altura */
        transform: translateY(-0.05em);
    }

    /*
       Ojo: acá NO va ningún transform, ni en :active ni en :hover. El
       latido del botón lo maneja GSAP, que escribe el transform en el
       atributo style, y eso le gana a cualquier regla de esta hoja: el
       hundido al apretar no se vería. El tamaño se toca solo desde el
       script; desde el CSS, únicamente la sombra.
    */
    .boton:active {
        box-shadow: 0 1px 4px rgba(7, 88, 67, 0.32);
    }

    @media (hover: hover) {
        .boton:hover {
            box-shadow: 0 5px 14px rgba(7, 88, 67, 0.36);
        }
    }

    .boton:focus-visible {
        outline: 2px solid #075843;
        outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
        .boton {
            transition: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("despedida");
        const boton = document.getElementById("boton-confirmar");
        if (!seccion) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const disparador = {
            trigger: seccion,
            start: "top 82%",
            toggleActions: "play none none reset",
        };

        // Las filigranas se abren desde el centro
        gsap.fromTo(
            seccion.querySelectorAll(".filigrana"),
            { opacity: 0, scaleX: 0.72 },
            {
                opacity: 1,
                scaleX: 1,
                duration: 1.1,
                stagger: 0.15,
                ease: "power2.out",
                scrollTrigger: disparador,
            },
        );

        gsap.fromTo(
            seccion.querySelector(".titulo"),
            { opacity: 0, y: 14 },
            {
                opacity: 1,
                y: 0,
                duration: 0.9,
                delay: 0.25,
                ease: "power2.out",
                scrollTrigger: disparador,
            },
        );

        gsap.fromTo(
            seccion.querySelectorAll(".parrafo"),
            { opacity: 0, y: 14 },
            {
                opacity: 1,
                y: 0,
                duration: 0.9,
                delay: 0.5,
                stagger: 0.2,
                ease: "power2.out",
                scrollTrigger: disparador,
            },
        );

        if (boton) {
            gsap.fromTo(
                boton,
                { opacity: 0, y: 14 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 1.2,
                    ease: "back.out(1.5)",
                    scrollTrigger: disparador,
                    /*
                       Y una vez puesto, late despacio. Es lo que avisa
                       que se puede tocar: sin esto el invitado lee la
                       frase y sigue de largo.
                    */
                    onComplete: () => {
                        gsap.to(boton, {
                            scale: 1.045,
                            duration: 1.5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );

            /*
               El hundido al apretar también va por GSAP y no por CSS:
               el latido deja un transform escrito en el style y una
               regla :active no puede contra eso.
            */
            boton.addEventListener("pointerdown", () => {
                gsap.killTweensOf(boton);
                gsap.to(boton, {
                    scale: 0.95,
                    duration: 0.12,
                    ease: "power2.out",
                });
            });

            const soltar = () =>
                gsap.to(boton, {
                    scale: 1,
                    duration: 0.25,
                    ease: "back.out(2)",
                });

            boton.addEventListener("pointerup", soltar);
            boton.addEventListener("pointercancel", soltar);
            boton.addEventListener("pointerleave", soltar);
        }
    });
</script>
