---
// src/components/Restriccion.astro
// Franja de papel crema rasgada con el "Celebración Para Adultos" y,
// debajo, el cartel de "sin niños", el pedido y el cierre.
//
// Acá el ramo va DETRÁS del papel, como en el cronograma: asoma por
// encima del filo rasgado en vez de apoyarse sobre él.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda   21.6% de alto

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Celebración Para Adultos";

const parrafo = [
    "Queremos que esta noche sea inolvidable.",
    "Para que todos podamos celebrar sin preocupaciones.",
    "La fiesta será solo para adultos",
];

const cierre = "¡Niños a la cama!";
// ──────────────────────────────────────────────────────────────
---

<section id="restriccion" class="seccion">
    <div class="marco-banda">
        <!-- El ramo asoma por detrás del papel (z-index 0, la banda va 1) -->
        <img
            src="/imagenes/florlateral2.png"
            alt=""
            aria-hidden="true"
            width="756"
            height="960"
            class="flores"
        />

        <div id="banda-restriccion" class="banda">
            <h2 class="titulo font-elegant">{titulo}</h2>
        </div>
    </div>

    <div id="cuerpo-restriccion" class="cuerpo">
        <div class="cartel" aria-hidden="true"></div>

        <div class="parrafo font-cormorant">
            {parrafo.map((linea) => <p>{linea}</p>)}
        </div>

        <p class="cierre font-cormorant">{cierre}</p>
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 3.5rem;
    }

    /* Sin recorte propio: el ramo tiene que poder salirse de la banda */
    .marco-banda {
        position: relative;
        width: 100%;
    }

    /*
       z-index 0 la manda DETRÁS del papel: la banda va con z-index 1 y le
       tapa la parte de abajo, así el ramo asoma por el filo rasgado.
       No se voltea: florlateral2 ya viene con los tulipanes para arriba.
    */
    .flores {
        position: absolute;
        top: -6rem;
        left: -1rem;
        width: 24%;
        height: auto;
        z-index: 0;
        pointer-events: none;
        user-select: none;
        filter: drop-shadow(0 6px 10px rgba(90, 70, 20, 0.18));
    }

    /*
       La banda de papel: el mismo rasgado del modelo, con el trazo corrido
       (52 arriba y 29 abajo) para que no repita el de las otras franjas.
    */
    .banda {
        position: relative;
        width: 100%;
        z-index: 1;
        background: #f7f3d3;
        padding: 2.6rem 1.8rem 2.8rem;
        clip-path: polygon(
            0.00% 3.84%,
            1.82% 6.00%,
            3.64% 4.95%,
            5.45% 5.64%,
            7.27% 8.50%,
            9.09% 4.15%,
            10.91% 4.00%,
            12.73% 4.25%,
            14.55% 6.51%,
            16.36% 5.98%,
            18.18% 6.16%,
            20.00% 5.56%,
            21.82% 4.89%,
            23.64% 6.00%,
            25.45% 6.46%,
            27.27% 6.49%,
            29.09% 6.36%,
            30.91% 4.33%,
            32.73% 7.05%,
            34.55% 5.69%,
            36.36% 3.71%,
            38.18% 2.14%,
            40.00% 1.75%,
            41.82% 2.50%,
            43.64% 3.40%,
            45.45% 5.33%,
            47.27% 4.30%,
            49.09% 5.93%,
            50.91% 6.47%,
            52.73% 6.21%,
            54.55% 4.14%,
            56.36% 5.07%,
            58.18% 5.17%,
            60.00% 6.42%,
            61.82% 5.33%,
            63.64% 5.17%,
            65.45% 4.87%,
            67.27% 3.99%,
            69.09% 2.21%,
            70.91% 2.09%,
            72.73% 0.51%,
            74.55% 1.63%,
            76.36% 2.75%,
            78.18% 2.97%,
            80.00% 4.20%,
            81.82% 6.82%,
            83.64% 5.66%,
            85.45% 5.36%,
            87.27% 3.60%,
            89.09% 3.56%,
            90.91% 4.10%,
            92.73% 3.27%,
            94.55% 2.37%,
            96.36% 4.14%,
            98.18% 6.65%,
            100.00% 5.79%,
            100.00% 94.83%,
            98.18% 94.93%,
            96.36% 95.86%,
            94.55% 93.79%,
            92.73% 93.53%,
            90.91% 94.07%,
            89.09% 95.70%,
            87.27% 94.67%,
            85.45% 96.60%,
            83.64% 97.50%,
            81.82% 98.25%,
            80.00% 97.86%,
            78.18% 96.29%,
            76.36% 94.31%,
            74.55% 92.95%,
            72.73% 95.67%,
            70.91% 93.64%,
            69.09% 93.51%,
            67.27% 93.54%,
