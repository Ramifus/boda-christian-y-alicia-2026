            63.64% 95.11%,
            61.82% 94.44%,
            60.00% 93.84%,
            58.18% 94.02%,
            56.36% 93.49%,
            54.55% 95.75%,
            52.73% 96.00%,
            50.91% 95.85%,
            49.09% 91.50%,
            47.27% 94.36%,
            45.45% 95.05%,
            43.64% 94.00%,
            41.82% 96.16%,
            40.00% 94.21%,
            38.18% 93.35%,
            36.36% 95.86%,
            34.55% 97.63%,
            32.73% 96.73%,
            30.91% 95.90%,
            29.09% 96.44%,
            27.27% 96.40%,
            25.45% 94.64%,
            23.64% 94.34%,
            21.82% 93.18%,
            20.00% 95.80%,
            18.18% 97.03%,
            16.36% 97.25%,
            14.55% 98.37%,
            12.73% 99.49%,
            10.91% 97.91%,
            9.09% 97.79%,
            7.27% 96.01%,
            5.45% 95.13%,
            3.64% 94.83%,
            1.82% 94.67%,
            0.00% 93.58%
        );
    }

    /* Mismo tamaño y color que los otros títulos de la invitación */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(2.35rem, 10.7vw, 2.9rem);
        line-height: 1.2;
    }

    /* ── El cuerpo ─────────────────────────────────────────── */
    .cuerpo {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 3rem 1.2rem 0;
        text-align: center;
    }

    /*
       El cartel de "sin niños". Como el bus de la ceremonia: el png viene
       en negro, así que se usa de máscara y el color lo pone el fondo,
       para que quede en el mismo marrón que el texto. Si el navegador no
       entiende mask, se ve el png tal cual.
    */
    .cartel {
        width: 27%;
        max-width: 7rem;
        aspect-ratio: 1;
        margin-bottom: 1.8rem;
        background: url("/imagenes/restriccion.png") center / contain no-repeat;
    }

    @supports (mask-image: url("")) or (-webkit-mask-image: url("")) {
        .cartel {
            background: #643e1a;
            -webkit-mask: url("/imagenes/restriccion.png") center / contain
                no-repeat;
            mask: url("/imagenes/restriccion.png") center / contain no-repeat;
        }
    }

    .parrafo {
        color: #643e1a;
        font-size: clamp(1.25rem, 5.5vw, 1.45rem);
        line-height: 1.65;
    }

    /*
       El cierre va en versales y con las letras separadas, como en el
       diseño. En Cormorant y no en Rantera porque esa no trae la "Ñ" ni
       los signos de apertura.
    */
    .cierre {
        margin-top: 2.2rem;
        color: #643e1a;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: clamp(1.5rem, 6.6vw, 1.8rem);
        line-height: 1.3;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-restriccion");
        const cuerpo = document.getElementById("cuerpo-restriccion");
        if (!banda || !cuerpo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           Las flores entran creciendo desde chiquitas hasta su tamaño y
           después quedan meciéndose despacio, como si estuvieran vivas.
        */
        const flores = document.querySelector<HTMLElement>(
            "#restriccion .flores",
        );
        if (flores) {
            gsap.fromTo(
                flores,
                { scaleX: 0.45, scaleY: 0.45, x: -70, opacity: 0 },
                {
                    scaleX: 1,
                    scaleY: 1,
                    x: 0,
                    opacity: 1,
                    duration: 1.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: flores,
                        start: "top 95%",
                        toggleActions: "play none none reset",
                    },
                    onComplete: () => {
                        gsap.to(flores, {
                            rotation: 1.6,
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );
        }

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        gsap.fromTo(
            [
                cuerpo.querySelector(".cartel"),
                ...cuerpo.querySelectorAll(".parrafo p"),
                cuerpo.querySelector(".cierre"),
            ].filter(Boolean),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.14,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: cuerpo,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
