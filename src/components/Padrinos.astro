---
// src/components/Padrinos.astro
// "Nuestros padrinos": una página con dos grupos de padrinos, cada uno en
// su tarjeta con la pareja de nombres en letra grande (se lee bien en el
// celular). Mismo estilo que la página de padres: flores arriba y abajo,
// placa de título y tarjetas crema.
//
// Se usa dos veces en Invitacion.astro (padrinos y padrinos-2), cada una
// con su parte de la lista `padrinos` de datos.ts.
export interface Props {
    id: string;
    grupos: { grupo: string; nombres: string[] }[];
}
const { id, grupos } = Astro.props;
---

<section id={id} class="padrinos">
    <img src="/imagenes/florarriba.webp" alt="" aria-hidden="true" width="828" height="276" class="flor flor-arriba" />
    <img src="/imagenes/florabajo.webp" alt="" aria-hidden="true" width="828" height="294" class="flor flor-abajo" />

    <div class="contenido">
        <header class="placa encabezado revelar">
            <p class="antes">Con su guía y cariño</p>
            <h2 class="titulo-padrinos">Nuestros Padrinos</h2>
        </header>

        <div class="divisor revelar" aria-hidden="true">
            <span class="linea linea-izq"></span>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M8 2.5 L11 8 L8 13.5 L5 8 Z"></path>
                <circle cx="8" cy="8" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
            <span class="linea linea-der"></span>
        </div>

        <p class="gracias revelar">Gracias por acompañarnos en este nuevo camino</p>

        <div class="tarjetas">
            {
                grupos.map((p) => (
                    <article class="placa tarjeta revelar">
                        <h3 class="grupo">{p.grupo}</h3>
                        <span class="raya" aria-hidden="true" />
                        <ul class="lista">
                            {p.nombres.map((n, i) => (
                                <>
                                    {i > 0 && <li class="y" aria-hidden="true">&</li>}
                                    <li>{n}</li>
                                </>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .padrinos {
        position: relative;
        text-align: center;
        /* Arriba deja ver la flor; el contenido arranca debajo. */
        padding: 3.75rem 1.25rem 0;
        background-image:
            radial-gradient(ellipse at 50% 45%, rgba(241, 236, 221, 0.9) 0%, rgba(251, 248, 240, 0) 70%),
            linear-gradient(#fbf8f0, #fbf8f0);
    }

    .flor {
        position: absolute;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .flor-arriba {
        top: 0;
    }

    .flor-abajo {
        bottom: 0;
        opacity: 0.9;
    }

    .contenido {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* La placa crema translúcida que va detrás de cada bloque. */
    .placa {
        border-radius: 1rem;
        background: rgba(251, 248, 240, 0.8);
        border: 1px solid rgba(195, 213, 182, 0.45);
        box-shadow: 0 1px 3px rgba(47, 69, 54, 0.06);
    }

    .encabezado {
        margin-top: 0.4rem;
        padding: 0.6rem 1.6rem 0.7rem;
    }

    .antes {
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.25rem;
        line-height: 1;
        color: var(--color-segundo);
    }

    .titulo-padrinos {
        margin-top: 0.75rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 2.25rem;
        line-height: 1.1;
        color: var(--color-oro-oscuro);
    }

    .divisor {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        max-width: 20rem;
        margin-top: 1rem;
        color: var(--color-segundo);
    }

    .divisor svg {
        width: 1rem;
        flex: none;
    }

    .linea {
        flex: 1;
        height: 1px;
    }

    .linea-izq {
        background: linear-gradient(to right, transparent, #c3d5b6);
    }

    .linea-der {
        background: linear-gradient(to left, transparent, #c3d5b6);
    }

    .gracias {
        margin-top: 1.6rem;
        max-width: 22rem;
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.5rem;
        line-height: 1.35;
        color: var(--color-segundo);
    }

    /* ── Una tarjeta por grupo ────────────────────────────── */
    .tarjetas {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        margin-top: 1.6rem;
    }

    .tarjeta {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.2rem 1.25rem 1.3rem;
        border-radius: 1.5rem;
    }

    .grupo {
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        line-height: 1.5;
        color: var(--color-oro-oscuro);
    }

    .raya {
        display: block;
        width: 4rem;
        height: 1px;
        margin-top: 0.55rem;
        background: #c3d5b6;
    }

    .lista {
        margin-top: 0.5rem;
        font-family: var(--font-titulo);
        font-size: 1.95rem;
        line-height: 1.25;
        color: var(--color-primero);
    }

    .y {
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 0.85rem;
        line-height: 1.4;
        color: var(--color-oro);
    }
</style>
