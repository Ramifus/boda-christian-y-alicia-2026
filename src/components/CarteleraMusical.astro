---
// src/components/CarteleraMusical.astro
// La cartelera musical: los grupos de la fiesta, separados por día con
// dos botones (Sábado / Domingo) como en el modelo; se ve un día a la vez. Es la única página de noche: fondo verde casi negro, dos
// haces de reflector dorados y, en cada tarjeta, brasas que suben desde
// abajo sobre el afiche del grupo, con un resplandor de fuego al pie.
//
// Las brasas se generan acá (posición, tamaño, demora y deriva), con un
// sorteo fijo por tarjeta: cada una tiene su propio fuego y siempre sale
// igual. Solo se mueven mientras la página está en pantalla.
// Los grupos salen de `cartelera` en datos.ts.
import { cartelera } from "../datos";

const BRASAS_POR_TARJETA = 12;

// Sorteo fijo: el mismo número da siempre el mismo resultado.
function azar(semilla: number) {
    const x = Math.sin(semilla * 12.9898) * 43758.5453;
    return x - Math.floor(x);
}

const grupos = cartelera.map((g, i) => ({
    ...g,
    brasas: Array.from({ length: BRASAS_POR_TARJETA }, (_, j) => {
        const r = (k: number) => azar(i * 97 + j * 13 + k);
        return [
            `--x:${(4 + r(1) * 92).toFixed(1)}%`,
            `--t:${(2.5 + r(2) * 3.5).toFixed(1)}px`,
            `--d:${(2.4 + r(3) * 2.6).toFixed(2)}s`,
            `--r:${(-r(4) * 5).toFixed(2)}s`,
            `--deriva:${((r(5) - 0.5) * 40).toFixed(0)}px`,
            `--alto:${(110 + r(6) * 90).toFixed(0)}px`,
        ].join(";");
    }),
}));

// Los días, en orden. La numeración (01, 02...) arranca de nuevo en cada uno.
const dias = [
    { clave: "sabado", nombre: "Sábado" },
    { clave: "domingo", nombre: "Domingo" },
]
    .map((d) => ({
        ...d,
        grupos: grupos
            .filter((g) => g.dia === d.clave)
            .map((g, i) => ({ ...g, numero: String(i + 1).padStart(2, "0") })),
    }))
    .filter((d) => d.grupos.length > 0);
---

<section id="cartelera" class="cartelera">
    <span class="haz haz-izq" aria-hidden="true"></span>
    <span class="haz haz-der" aria-hidden="true"></span>

    <img src="/imagenes/florarriba.webp" alt="" aria-hidden="true" width="828" height="276" class="flor flor-arriba" />
    <img src="/imagenes/florabajo.webp" alt="" aria-hidden="true" width="828" height="294" class="flor flor-abajo" />

    <div class="contenido">
        <header class="encabezado revelar">
            <p class="antes">Nos acompañan</p>
            <h2 class="titulo-cartelera">Cartelera Musical</h2>
        </header>

        <p class="lema revelar">Una noche de música, baile y alegría</p>

        <div class="estrellitas revelar" aria-hidden="true">
            <span></span><span class="grande"></span><span></span>
        </div>

        <div class="dias revelar" role="tablist" aria-label="Día">
            {
                dias.map((d, i) => (
                    <button
                        type="button"
                        role="tab"
                        class:list={["dia", { activo: i === 0 }]}
                        id={`dia-${d.clave}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`lista-${d.clave}`}
                        data-dia={d.clave}
                    >
                        {d.nombre}
                    </button>
                ))
            }
        </div>

        {
            dias.map((d, i) => (
                <ol
                    class="grilla"
                    id={`lista-${d.clave}`}
                    role="tabpanel"
                    aria-labelledby={`dia-${d.clave}`}
                    hidden={i !== 0}
                >
                    {d.grupos.map((g) => (
                        <li class="carta revelar">
                            <span class="numero">{g.numero}</span>

                            <div class="marco">
                                <img src={g.imagen} alt={g.nombre} width={g.ancho} height={g.alto} loading="lazy" />
                                <div class="fuego" aria-hidden="true">
                                    {g.brasas.map((estilo) => (
                                        <span class="brasa" style={estilo} />
                                    ))}
                                </div>
                            </div>

                            <h3 class="nombre">{g.nombre}</h3>
                            {g.detalle && <p class="detalle">{g.detalle}</p>}
                        </li>
                    ))}
                </ol>
            ))
        }

        <p class="cierre revelar">¡Prepárate para bailar toda la noche!</p>
    </div>
</section>

<style>
    .cartelera {
        position: relative;
        text-align: center;
        /* Arriba deja ver la flor; el contenido arranca debajo. */
        padding: 3.75rem 1.1rem 0;
        /* La noche: verde casi negro, con la luz de escenario que baja de arriba. */
        background-image:
            radial-gradient(ellipse 90% 40% at 50% 0%, rgba(230, 208, 160, 0.22) 0%, transparent 70%),
            radial-gradient(ellipse 120% 50% at 50% 100%, rgba(255, 110, 30, 0.12) 0%, transparent 70%),
            linear-gradient(#101b15, #0a120d);
        color: #f1ecdd;
    }

    /* ── Los reflectores ──────────────────────────────────── */
    .haz {
        position: absolute;
        top: -10%;
        width: 55%;
        height: 75%;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(230, 208, 160, 0.22), transparent 85%);
        clip-path: polygon(45% 0, 55% 0, 100% 100%, 0 100%);
        filter: blur(6px);
        mix-blend-mode: screen;
        animation: barrer 9s ease-in-out infinite;
    }

    .haz-izq {
        left: -12%;
        transform-origin: 50% 0;
        rotate: -22deg;
    }

    .haz-der {
        right: -12%;
        transform-origin: 50% 0;
        rotate: 22deg;
        animation-delay: -4.5s;
    }

    @keyframes barrer {
        0%, 100% { transform: rotate(-6deg); opacity: 0.7; }
        50% { transform: rotate(6deg); opacity: 1; }
    }

    .flor {
        position: absolute;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .flor-arriba {
        top: 0;
        opacity: 0.9;
    }

    .flor-abajo {
        bottom: 0;
        opacity: 0.5;
    }

    .contenido {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ── El encabezado ────────────────────────────────────── */
    .encabezado {
        margin-top: 0.4rem;
        padding: 0.65rem 1.7rem 0.75rem;
        border-radius: 1rem;
        background: rgba(10, 18, 13, 0.55);
        border: 1px solid rgba(230, 208, 160, 0.35);
        box-shadow: 0 0 24px -6px rgba(230, 208, 160, 0.25);
        backdrop-filter: blur(4px);
    }

    .antes {
        font-family: var(--font-nombre);
        font-style: italic;
        font-size: 1.2rem;
        line-height: 1;
        color: #e6d0a0;
    }

    .titulo-cartelera {
        margin-top: 0.7rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 2.6rem;
        line-height: 1.1;
        background: linear-gradient(170deg, #fff3d1 0%, #e6d0a0 40%, #bfa06a 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 0 10px rgba(230, 208, 160, 0.35));
    }

    .lema {
        margin-top: 1rem;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.66rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #e6d0a0;
    }

    .estrellitas {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.8rem;
    }

    .estrellitas span {
        width: 0.35rem;
        height: 0.35rem;
        rotate: 45deg;
        background: #bfa06a;
    }

    .estrellitas .grande {
        width: 0.55rem;
        height: 0.55rem;
        background: #e6d0a0;
        box-shadow: 0 0 8px rgba(230, 208, 160, 0.8);
    }

    /* ── Los botones de día ────────────────────────────────── */
    .dias {
        display: flex;
        gap: 0.3rem;
        margin-top: 1.3rem;
        padding: 0.3rem;
        border-radius: 9999px;
        background: rgba(10, 18, 13, 0.6);
        border: 1px solid rgba(230, 208, 160, 0.4);
        box-shadow: 0 0 18px -6px rgba(230, 208, 160, 0.3);
    }

    .dia {
        min-width: 7.2rem;
        padding: 0.7rem 1.4rem;
        border-radius: 9999px;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #e6d0a0;
        transition: background-color 0.35s, color 0.35s, box-shadow 0.35s;
    }

    .dia.activo {
        background: linear-gradient(170deg, #f3dfae, #bfa06a);
        color: #101b15;
        box-shadow: 0 0 16px rgba(230, 208, 160, 0.55);
    }

    /* Al cambiar de día, las tarjetas nuevas entran suaves. */
    .grilla.entrando .carta {
        animation: aparecer 0.6s ease both;
    }

    .grilla.entrando .carta:nth-child(2) { animation-delay: 0.08s; }
    .grilla.entrando .carta:nth-child(3) { animation-delay: 0.16s; }
    .grilla.entrando .carta:nth-child(4) { animation-delay: 0.24s; }
    .grilla.entrando .carta:nth-child(5) { animation-delay: 0.32s; }

    @keyframes aparecer {
        from { opacity: 0; transform: translateY(14px) scale(0.97); }
        to { opacity: 1; transform: none; }
    }

    /* ── Las tarjetas ─────────────────────────────────────── */
    .grilla {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.1rem 0.8rem;
        width: 100%;
        margin-top: 1.5rem;
    }

    .grilla[hidden] {
        display: none;
    }

    /* Si queda una sola en la última fila, va centrada. */
    .carta:last-child:nth-child(odd) {
        grid-column: 1 / -1;
        justify-self: center;
        width: calc(50% - 0.4rem);
    }

    .carta {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .numero {
        position: absolute;
        z-index: 3;
        top: -0.55rem;
        left: 50%;
        translate: -50% 0;
        padding: 0.15rem 0.6rem;
        border-radius: 9999px;
        background: linear-gradient(170deg, #e6d0a0, #bfa06a);
        color: #101b15;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        box-shadow: 0 0 10px rgba(230, 208, 160, 0.5);
    }

    .marco {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: 1rem;
        padding: 0.35rem;
        background:
            radial-gradient(ellipse 120% 60% at 50% 110%, rgba(255, 120, 30, 0.45) 0%, transparent 70%),
            linear-gradient(#0d1611, #0d1611);
        border: 1px solid rgba(230, 208, 160, 0.55);
        box-shadow:
            0 0 0 3px rgba(16, 27, 21, 0.9),
            0 0 0 4px rgba(191, 160, 106, 0.35),
            0 14px 26px -12px rgba(0, 0, 0, 0.8);
        animation: latir 3.2s ease-in-out infinite;
    }

    /* El afiche, entero, apoyado sobre el resplandor. */
    .marco img {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        object-fit: contain;
        border-radius: 0.65rem;
    }

    /* El resplandor del fuego al pie de cada afiche. */
    .marco::after {
        content: "";
        position: absolute;
        z-index: 2;
        left: 0;
        right: 0;
        bottom: 0;
        height: 40%;
        pointer-events: none;
        background: radial-gradient(ellipse 70% 100% at 50% 100%, rgba(255, 140, 40, 0.5) 0%, rgba(255, 80, 20, 0.15) 45%, transparent 75%);
        transform-origin: bottom center;
        mix-blend-mode: screen;
        animation: titilar 1.6s ease-in-out infinite alternate;
    }

    @keyframes latir {
        0%, 100% { border-color: rgba(230, 208, 160, 0.45); }
        50% { border-color: rgba(255, 190, 110, 0.85); }
    }

    @keyframes titilar {
        0% { opacity: 0.55; transform: scaleY(0.9); }
        100% { opacity: 1; transform: scaleY(1.08); }
    }

    /* ── Las brasas ───────────────────────────────────────── */
    .fuego {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
    }

    .brasa {
        position: absolute;
        bottom: -6px;
        left: var(--x);
        width: var(--t);
        height: var(--t);
        border-radius: 50%;
        background: radial-gradient(circle, #fff6c8 0%, #ffc24d 35%, #ff6a1a 70%, transparent 72%);
        box-shadow: 0 0 6px 2px rgba(255, 140, 40, 0.65);
        mix-blend-mode: screen;
        opacity: 0;
        animation: subir var(--d) ease-in infinite var(--r);
    }

    @keyframes subir {
        0% { transform: translate(0, 0) scale(1); opacity: 0; }
        12% { opacity: 1; }
        70% { opacity: 0.85; }
        100% { transform: translate(var(--deriva), calc(var(--alto) * -1)) scale(0.2); opacity: 0; }
    }

    /* Fuera de pantalla, todo quieto: no gasta batería. */
    .cartelera:not(.en-pantalla) .brasa,
    .cartelera:not(.en-pantalla) .marco,
    .cartelera:not(.en-pantalla) .marco::after,
    .cartelera:not(.en-pantalla) .haz {
        animation-play-state: paused;
    }

    .nombre {
        margin-top: 0.65rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 1.55rem;
        line-height: 1.1;
        text-wrap: balance;
        color: #f1ecdd;
        text-shadow: 0 0 12px rgba(255, 160, 60, 0.35);
    }

    .detalle {
        margin-top: 0.2rem;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.55rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #bfa06a;
    }

    .cierre {
        margin-top: 1.8rem;
        font-family: var(--font-titulo);
        font-size: 2rem;
        line-height: 1.2;
        color: #e6d0a0;
        text-shadow: 0 0 14px rgba(255, 160, 60, 0.4);
    }

    @media (prefers-reduced-motion: reduce) {
        .brasa, .haz, .marco, .marco::after {
            animation: none;
        }
    }
</style>

<script>
    // Las brasas y los reflectores se mueven solo con la página a la vista.
    const cartelera = document.getElementById("cartelera");
    if (cartelera) {
        // Los botones de día: muestran la lista de ese día y esconden la otra.
        const botones = Array.from(cartelera.querySelectorAll<HTMLElement>(".dia"));
        botones.forEach((boton) => {
            boton.addEventListener("click", () => {
                botones.forEach((b) => {
                    const elegido = b === boton;
                    b.classList.toggle("activo", elegido);
                    b.setAttribute("aria-selected", String(elegido));
                    const lista = document.getElementById(`lista-${b.dataset.dia}`);
                    if (!lista) return;
                    lista.hidden = !elegido;
                    lista.classList.remove("entrando");
                    if (elegido) {
                        void lista.offsetWidth;
                        lista.classList.add("entrando");
                    }
                });
            });
        });

        new IntersectionObserver(
            ([e]) => cartelera.classList.toggle("en-pantalla", e.isIntersecting),
            { threshold: 0.2 },
        ).observe(cartelera);
    }
</script>
