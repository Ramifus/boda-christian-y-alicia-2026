---
// src/components/Lugar.astro
// Una página de lugar (la ceremonia o la recepción): placa con el día, y
// una tarjeta con el nombre del lugar, la dirección, la hora, la foto y el
// botón "Cómo llegar". Flores arriba y abajo, como el resto de las páginas.
//
// La usan CeremoniaReligiosa.astro y RecepcionSocial.astro, cada una con
// sus datos de datos.ts. Si la foto trae fotoRecorte (por ejemplo "6 / 5")
// se recorta a esa proporción; si no, va entera.
import { fechaTitulo } from "../datos";

export interface Props {
    id: string;
    evento: {
        titulo: string;
        lugar: string;
        direccion: string;
        hora: string;
        periodo: string;
        mapa: string;
        foto: string;
        fotoAncho: number;
        fotoAlto: number;
        fotoRecorte?: string;
    };
}
const { id, evento } = Astro.props;
---

<section id={id} class="lugar-pagina">
    <img src="/imagenes/florarriba.webp" alt="" aria-hidden="true" width="828" height="276" class="flor flor-arriba" />
    <img src="/imagenes/florabajo.webp" alt="" aria-hidden="true" width="828" height="294" class="flor flor-abajo" />

    <div class="contenido">
        <h2 class="placa encabezado revelar">
            {fechaTitulo.dia} {fechaTitulo.numero} {fechaTitulo.mes}
        </h2>

        <article class="placa tarjeta revelar">
            <p class="etiqueta">{evento.titulo}</p>
            <h3 class="lugar">{evento.lugar}</h3>
            <p class="direccion">{evento.direccion}</p>

            <p class="hora">
                <span class="hora-numero">{evento.hora}</span>
                <span class="hora-periodo">{evento.periodo}</span>
            </p>

            <figure class="foto">
                <img
                    src={evento.foto}
                    alt={evento.lugar}
                    style={evento.fotoRecorte ? `aspect-ratio: ${evento.fotoRecorte}` : undefined}
                    width={evento.fotoAncho}
                    height={evento.fotoAlto}
                    loading="lazy"
                />
            </figure>

            <a href={evento.mapa} target="_blank" rel="noopener" class="como-llegar">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M21 3 3 10.5l7.2 2.3L12.5 20 21 3Z"></path>
                </svg>
                Cómo llegar
            </a>
        </article>
    </div>
</section>

<style>
    .lugar-pagina {
        position: relative;
        text-align: center;
        /* Arriba deja ver la flor; el contenido arranca debajo. */
        padding: 3.75rem 1.25rem 0;
        background-image:
            radial-gradient(ellipse at 50% 45%, rgba(241, 236, 221, 0.9) 0%, rgba(251, 248, 240, 0) 70%),
            linear-gradient(#fbf8f0, #fbf8f0);
    }

    .flor {
        position: absolute;
        left: 0;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .flor-arriba {
        top: 0;
    }

    .flor-abajo {
        bottom: 0;
        opacity: 0.9;
    }

    .contenido {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* La placa crema translúcida que va detrás de cada bloque. */
    .placa {
        border-radius: 1rem;
        background: rgba(251, 248, 240, 0.8);
        border: 1px solid rgba(195, 213, 182, 0.45);
        box-shadow: 0 1px 3px rgba(47, 69, 54, 0.06);
    }

    .encabezado {
        margin-top: 0.4rem;
        padding: 0.55rem 1.4rem 0.6rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 1.875rem;
        line-height: 1.2;
        color: var(--color-oro-oscuro);
    }

    /* ── La tarjeta ───────────────────────────────────────── */
    .tarjeta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        margin-top: 1rem;
        padding: 1.25rem 1.25rem 1.3rem;
        border-radius: 1.5rem;
    }

    .etiqueta {
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.6875rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-segundo);
    }

    .lugar {
        margin-top: -0.3rem;
        font-family: var(--font-titulo);
        font-weight: 400;
        font-size: 2.1rem;
        line-height: 1.15;
        text-wrap: balance;
        color: var(--color-oro-oscuro);
    }

    .direccion {
        font-family: var(--font-texto);
        font-size: 0.875rem;
        line-height: 1.6;
        text-transform: uppercase;
        text-wrap: balance;
        color: color-mix(in srgb, var(--color-primero) 75%, transparent);
    }

    .hora {
        display: inline-flex;
        align-items: baseline;
        gap: 0.4rem;
        color: var(--color-segundo);
    }

    .hora-numero {
        font-family: "Tangerine", cursive;
        font-size: 3rem;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .hora-periodo {
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.2em;
    }

    .foto {
        width: 100%;
        margin-top: 0.25rem;
    }

    .foto img {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: center 30%;
        border-radius: 1rem;
        border: 1px solid rgba(195, 213, 182, 0.4);
        background: #f1ecdd;
    }

    .como-llegar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        min-height: 3rem;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        background: var(--color-segundo);
        color: #fbf8f0;
        font-family: var(--font-texto);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        box-shadow: 0 8px 18px -8px rgba(87, 118, 79, 0.7);
        transition: background-color 0.25s;
    }

    .como-llegar:hover {
        background: var(--color-primero);
    }

    .como-llegar svg {
        width: 0.85rem;
    }
</style>
