---
// src/components/Invitacion.astro
// El cuerpo completo de la invitación, en orden. Los datos de cada sección
// están en src/datos.ts.
import Sobre from "./Sobre.astro";
import NombresFlores from "./NombresFlores.astro";
import Contador from "./Contador.astro";
import Padres from "./Padres.astro";
import Padrinos from "./Padrinos.astro";
import CeremoniaReligiosa from "./CeremoniaReligiosa.astro";
import RecepcionSocial from "./RecepcionSocial.astro";
import Itinerario from "./Itinerario.astro";
import Galeria from "./Galeria.astro";
import CarteleraMusical from "./CarteleraMusical.astro";
import Producciones from "./Producciones.astro";
import Pase from "./Pase.astro";
import Despedida from "./Despedida.astro";
import Menu from "./Menu.astro";
import BotonMusica from "./BotonMusica.astro";
import { padrinos } from "../datos";

/*
   Cuántos lugares reserva esta invitación. Lo manda la página:
   index.astro no pasa nada (sin pase); pase[cantidad].astro pasa el
   número de la URL (/pase1, /pase2...).
*/
export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;
---

<Sobre />

<div id="contenido-principal">
    <NombresFlores />
    <Contador />
    <Padres />
    <Padrinos id="padrinos" grupos={padrinos.slice(0, 2)} />
    <Padrinos id="padrinos-2" grupos={padrinos.slice(2)} />
    <CeremoniaReligiosa />
    <RecepcionSocial />
    <Galeria />
    <CarteleraMusical />
    <Producciones />
    <!-- <Itinerario /> -->
    
    <!-- <Pase pases={pases} /> -->
    <Despedida />
</div>

<Menu />
<BotonMusica />

<style is:global>
    /*
       Las páginas van una al lado de la otra y se pasan deslizando de
       costado, como en el modelo: la siguiente entra desde la derecha.
       Cada sección es una página del alto de la pantalla; si su contenido
       no entra, se baja con el dedo adentro de esa misma página.
    */
    #contenido-principal {
        display: flex;
        height: 100svh;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
    }

    #contenido-principal::-webkit-scrollbar {
        display: none;
    }

    #contenido-principal > section {
        flex: 0 0 100%;
        height: 100svh;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior-y: contain;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        scrollbar-width: none;
    }

    /* Lugar para la barra de abajo, que flota encima. La de nombres y
       flores ya deja el suyo para la flor de abajo. */
    #contenido-principal > section:not(#inicio) {
        padding-bottom: 6rem;
    }

    #contenido-principal > section::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    import { iniciarAnimaciones } from "../scripts/animaciones";

    const contenedor = document.getElementById("contenido-principal")!;
    const paginas = Array.from(contenedor.querySelectorAll<HTMLElement>(":scope > section"));
    const ids = paginas.map((p) => p.id);
    let indice = 0;

    iniciarAnimaciones(contenedor);


    function irA(i: number) {
        const destino = Math.max(0, Math.min(paginas.length - 1, i));
        contenedor.scrollTo({ left: destino * contenedor.clientWidth });
    }

    // Avisa qué página se está viendo (para el contador y el nombre).
    function avisar() {
        const nuevo = Math.round(contenedor.scrollLeft / contenedor.clientWidth);
        if (nuevo === indice && contenedor.dataset.avisado) return;
        indice = nuevo;
        contenedor.dataset.avisado = "1";
        window.dispatchEvent(
            new CustomEvent("pagina-cambio", { detail: { id: ids[indice], indice } }),
        );
    }

    contenedor.addEventListener("scroll", avisar, { passive: true });

    /*
       El primer aviso espera un cuadro: así la barra de abajo y las
       flechitas (Menu.astro) ya están escuchando, sin importar en qué
       orden se carguen los scripts.
    */
    requestAnimationFrame(() => {
        window.dispatchEvent(new CustomEvent("paginas-listas", { detail: ids }));
        avisar();
    });

    /*
       Los enlaces a una sección ("Desliza para leer") y los botones de la
       lista de páginas llevan a esa página deslizando, sin saltar.
    */
    document.addEventListener("click", (e) => {
        const objetivo = (e.target as HTMLElement).closest<HTMLElement>('a[href^="#"], [data-ir]');
        if (!objetivo) return;
        const id = objetivo.dataset.ir ?? objetivo.getAttribute("href")!.slice(1);
        const i = ids.indexOf(id);
        if (i === -1) return;
        e.preventDefault();
        irA(i);
    });

    // Las flechitas de arriba (Menu.astro): -1 atrás, 1 adelante.
    window.addEventListener("pagina-paso", (e) => irA(indice + (e as CustomEvent).detail));

    /*
       En computadora: la rueda del mouse pasa de página (abajo = siguiente,
       arriba = anterior). Si la página es más larga que la pantalla,
       primero baja su contenido y recién en el borde pasa de página.
       La pausa evita que un solo giro salte varias páginas.
    */
    let pausaRueda = false;
    contenedor.addEventListener(
        "wheel",
        (e) => {
            // Los gestos de costado del touchpad ya deslizan solos.
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

            const pagina = paginas[indice];
            const bajando = e.deltaY > 0;
            const puedeBajar = pagina.scrollTop + pagina.clientHeight < pagina.scrollHeight - 2;
            const puedeSubir = pagina.scrollTop > 2;
            if ((bajando && puedeBajar) || (!bajando && puedeSubir)) return;

            e.preventDefault();
            if (pausaRueda || Math.abs(e.deltaY) < 8) return;
            pausaRueda = true;
            irA(indice + (bajando ? 1 : -1));
            setTimeout(() => (pausaRueda = false), 800);
        },
        { passive: false },
    );

    // En computadora: las flechas del teclado pasan de página.
    document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") irA(indice + 1);
        if (e.key === "ArrowLeft") irA(indice - 1);
    });

    // Al cambiar el tamaño de la ventana, se queda en la misma página.
    window.addEventListener("resize", () => {
        contenedor.style.scrollBehavior = "auto";
        irA(indice);
        contenedor.style.scrollBehavior = "";
    });
</script>
